{
  "sentence_warn_chars": 90,
  "sentence_error_chars": 150,
  "max_commas": 5,
  "paragraph_warn_chars": 500,
  "require_lead_heading": true,
  "lead_min_chars": 600,
  "lead_headings": ["結論", "概要", "要約", "目的", "決定事項"],
  "redundant_phrases": ["することができます", "ということになります", "ということができます", "においては", "非常にとても"],
  "vague_phrases": ["必要に応じて", "適切に", "十分な", "可能な限り", "なるべく"],
  "term_variants": [["ユーザ", "ユーザー"], ["サーバ", "サーバー"], ["インタフェース", "インターフェース"]],
  "protected_terms": []
}
